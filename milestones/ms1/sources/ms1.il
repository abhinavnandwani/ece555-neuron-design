; generated by gen_skill.py -- ECE 555 MS1 neuron cells
nLib = "NEURON"
nLog = outfile("/userspace/apyadav/ece555/ms1/build.txt")
unless(ddGetObj(nLib)
  let((l) l = ddCreateLib(nLib "/userspace/apyadav/ece555/NEURON")
    techBindTechFile(l "asap7_TechLib")
    fprintf(nLog "created lib %L\n" l)))

procedure(nPinCenter(inst term)
  let((tm bb c)
    tm = car(setof(x inst~>master~>terminals x~>name == term))
    bb = car(tm~>pins)~>fig~>bBox
    c = list((xCoord(car(bb)) + xCoord(cadr(bb))) / 2.0
             (yCoord(car(bb)) + yCoord(cadr(bb))) / 2.0)
    dbTransformPoint(c inst~>transform)))
procedure(nWire(cv pts) car(schCreateWire(cv "draw" "full" pts 0.0625 0.0625 0.0)))
procedure(nLabel(cv wr xy name just)
  schCreateWireLabel(cv wr xy name just "R0" "stick" 0.0625 nil))
procedure(nStub(cv inst term dx dy name)
  let((p q just)
    p = nPinCenter(inst term)
    q = list(xCoord(p) + dx yCoord(p) + dy)
    just = cond((dx < 0 "lowerRight") (dx > 0 "lowerLeft") (t "lowerCenter"))
    nLabel(cv nWire(cv list(p q)) q name just)))
; stub pointing away from the symbol body (pin on bbox edge decides direction)
procedure(nStubAuto(cv inst term len name)
  let((p bb dx dy)
    p = nPinCenter(inst term)
    bb = inst~>master~>bBox
    bb = list(dbTransformPoint(car(bb) inst~>transform) dbTransformPoint(cadr(bb) inst~>transform))
    dx = 0 dy = 0
    cond(
      (abs(xCoord(p) - min(xCoord(car(bb)) xCoord(cadr(bb)))) < 0.03 dx = -len)
      (abs(xCoord(p) - max(xCoord(car(bb)) xCoord(cadr(bb)))) < 0.03 dx = len)
      (abs(yCoord(p) - max(yCoord(car(bb)) yCoord(cadr(bb)))) < 0.03 dy = len)
      (t dy = -len))
    nStub(cv inst term dx dy name)))
procedure(nMos(cv typ name xy nfin)
  let((m inst)
    m = dbOpenCellViewByType("asap7_TechLib" if(typ == "p" "pmos_rvt" "nmos_rvt") "symbol")
    inst = schCreateInst(cv m name xy "R0")
    dbReplaceProp(inst "nfin" "int" nfin)
    dbReplaceProp(inst "w" "string" sprintf(nil "%dn" 27*nfin))
    dbReplaceProp(inst "l" "string" "20n")
    inst))
procedure(nPin(cv name dir xy)
  let((m pin p q)
    m = dbOpenCellViewByType("basic" case(dir ("input" "ipin") ("output" "opin") (t "iopin")) "symbol")
    pin = schCreatePin(cv m name dir nil xy "R0")
    p = nPinCenter(pin car(pin~>master~>terminals)~>name)
    q = list(xCoord(p) + if(dir == "output" -0.5 0.5) yCoord(p))
    nLabel(cv nWire(cv list(p q)) q name if(dir == "output" "lowerRight" "lowerLeft"))
    pin))
; terminals of a mos symbol: D/S direction from pin position vs origin
procedure(nMosStubs(cv inst d g s b)
  let((pd ps o)
    o = inst~>xy
    pd = nPinCenter(inst "D") ps = nPinCenter(inst "S")
    nStub(cv inst "D" 0 if(yCoord(pd) > yCoord(o) 0.25 -0.25) d)
    nStub(cv inst "S" 0 if(yCoord(ps) > yCoord(o) 0.25 -0.25) s)
    nStub(cv inst "G" -0.375 0 g)
    nStub(cv inst "B" 0.875 0 b)))
procedure(nDump(cv)
  fprintf(nLog "CELL %s\n" cv~>cellName)
  foreach(i cv~>instances
    unless(i~>purpose == "pin"
      fprintf(nLog "  I %s %s %L %L\n" i~>name i~>cellName i~>nfin
        sort(mapcar(lambda((it) strcat(it~>term~>name "=" it~>net~>name)) i~>instTerms) 'alphalessp))))
  fprintf(nLog "  TERMS %L\n" sort(cv~>terminals~>name 'alphalessp)))
procedure(nSymPin(cv name dir xy lead labXY labJust)
  let((x y fig net term)
    x = xCoord(xy) y = yCoord(xy)
    dbCreateLine(cv list("device" "drawing") list(xy lead))
    fig = dbCreateRect(cv list("pin" "drawing") list(list(x - 0.025 y - 0.025) list(x + 0.025 y + 0.025)))
    net = dbCreateNet(cv name)
    term = dbCreateTerm(net name dir)
    dbCreatePin(net fig name)
    when(labXY dbCreateLabel(cv list("pin" "drawing") labXY name labJust "R0" "stick" 0.045))
    term))
procedure(nSymFinish(cv bb)
  let((lb)
    dbCreateRect(cv list("instance" "drawing") bb)
    lb = dbCreateLabel(cv list("annotate" "drawing7") list(xCoord(car(bb)) yCoord(cadr(bb)) + 0.03)
                       "[@instanceName]" "lowerLeft" "R0" "stick" 0.05)
    lb~>labelType = "NLPLabel"
    dbReplaceProp(cv "interfaceLastChanged" "time" getCurrentTime())
    dbSave(cv) dbClose(cv)))

