    nPin(cv "X1_0" "input" -3.0000:-0.8750)
    nPin(cv "W1_1" "input" -3.0000:-1.2500)
    nPin(cv "W1_0" "input" -3.0000:-1.6250)
    nPin(cv "B_1" "input" -3.0000:-2.0000)
    nPin(cv "B_0" "input" -3.0000:-2.3750)
    nPin(cv "VDD" "inputOutput" -3.0000:-2.7500)
    nPin(cv "VSS" "inputOutput" -3.0000:-3.1250)
    xr = xCoord(cadr(dbComputeBBoxNoNLP(cv)))
    nPin(cv "Z2" "output" list(xr + 1.5 1.0))
    nPin(cv "Z1" "output" list(xr + 1.5 0.625))
    nPin(cv "Z0" "output" list(xr + 1.5 0.25))
    schCheck(cv) dbSave(cv)
    fprintf(nLog "%s check markers=%L\n" cv~>cellName length(setof(s cv~>shapes s~>objType == "marker")))
    nDump(cv) dbClose(cv)
  cv = dbOpenCellViewByType(nLib "NEURON" "symbol" "schematicSymbol" "w")
    dbCreateLine(cv list("device" "drawing") list(0.2500:1.3750 1.2500:1.3750 1.2500:-1.3750 0.2500:-1.3750 0.2500:1.3750))
    dbCreateLabel(cv list("device" "label") 0.7500:1.3150 "NEURON" "upperCenter" "R0" "stick" 0.06)
    nSymPin(cv "X0_1" "input" 0.0000:1.1250 0.2500:1.1250 0.2800:1.1250 "centerLeft")
    nSymPin(cv "X0_0" "input" 0.0000:0.8750 0.2500:0.8750 0.2800:0.8750 "centerLeft")
    nSymPin(cv "W0_1" "input" 0.0000:0.6250 0.2500:0.6250 0.2800:0.6250 "centerLeft")
    nSymPin(cv "W0_0" "input" 0.0000:0.3750 0.2500:0.3750 0.2800:0.3750 "centerLeft")
    nSymPin(cv "X1_1" "input" 0.0000:0.1250 0.2500:0.1250 0.2800:0.1250 "centerLeft")
    nSymPin(cv "X1_0" "input" 0.0000:-0.1250 0.2500:-0.1250 0.2800:-0.1250 "centerLeft")
    nSymPin(cv "W1_1" "input" 0.0000:-0.3750 0.2500:-0.3750 0.2800:-0.3750 "centerLeft")
    nSymPin(cv "W1_0" "input" 0.0000:-0.6250 0.2500:-0.6250 0.2800:-0.6250 "centerLeft")
    nSymPin(cv "B_1" "input" 0.0000:-0.8750 0.2500:-0.8750 0.2800:-0.8750 "centerLeft")
    nSymPin(cv "B_0" "input" 0.0000:-1.1250 0.2500:-1.1250 0.2800:-1.1250 "centerLeft")
    nSymPin(cv "Z2" "output" 1.5000:1.1250 1.2500:1.1250 1.2200:1.1250 "centerRight")
    nSymPin(cv "Z1" "output" 1.5000:0.8750 1.2500:0.8750 1.2200:0.8750 "centerRight")
    nSymPin(cv "Z0" "output" 1.5000:0.6250 1.2500:0.6250 1.2200:0.6250 "centerRight")
    nSymPin(cv "VDD" "inputOutput" 0.7500:1.6250 0.7500:1.3750 nil nil)
    nSymPin(cv "VSS" "inputOutput" 0.7500:-1.6250 0.7500:-1.3750 nil nil)
    dbCreateLabel(cv list("annotate" "drawing8") 0.7500:-1.7250 "[@cellName]" "upperCenter" "R0" "stick" 0.045)~>labelType = "NLPLabel"
    nSymFinish(cv list(0.0000:-1.6250 1.5000:1.6250))
) t)
when(errset.errset fprintf(nLog "ERROR %L\n" errset.errset))
close(nLog)
exit()
